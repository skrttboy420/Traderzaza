# ---------------------------------------------------------------------------
# AI Trading Coach — environment template
#
# Copy this file to `.env.local` (that path is git-ignored) and fill in only
# what you actually have. Every variable below is OPTIONAL: with an empty file
# the app still runs, still computes every number, and tells you honestly which
# parts are degraded (see /settings → "Market data" and "AI assistant").
#
# All of these are read server-side only, in `apps/web/src/lib/env.ts`.
# Nothing except the two NEXT_PUBLIC_* values can ever reach the browser.
# ---------------------------------------------------------------------------


# === AI (Anthropic Claude) =================================================

# Your Anthropic API key.
#   Set     -> the AI layer writes the explanations, coaching and lessons.
#   Not set -> the deterministic `LocalExplainer` writes them instead. Every
#              number is identical (the engine computes all maths either way);
#              only the prose is stiffer. The UI labels which one answered.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model to call. Leave empty to use the app default.
# Example: claude-sonnet-4-6
ANTHROPIC_MODEL=


# === Market data ===========================================================

# Twelve Data API key — the feed for metals (XAUUSD) and FX (EURUSD, GBPUSD,
# USDJPY).
#   Set     -> those symbols report quality LIVE.
#   Not set -> those symbols fall back to the seeded mock provider and are
#              labelled DEMO everywhere they appear. They are never silently
#              presented as real prices.
# Free tier at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Use Binance's public REST endpoints for BTCUSDT / ETHUSDT. No key needed.
#   true (default) -> crypto is LIVE out of the box.
#   false          -> crypto falls back to DEMO as well.
ENABLE_BINANCE=true

# Force every symbol onto the mock provider, ignoring the keys above.
# Useful for demos, offline work, and for not burning API quota while
# developing. Everything is labelled DEMO while this is on.
FORCE_DEMO_DATA=false

# How many candles each timeframe request asks the provider for.
# Higher = more history for structure detection and replay, slower requests.
# Default 400. The structure engine wants at least ~200 to be meaningful.
CANDLE_LIMIT=400


# === Economic calendar (news) ==============================================
#
# No key is needed for any of this. The calendar providers are public
# endpoints, which is also why they are tried in a fixed order and why the
# panel always names the source that answered.

# Master switch for the News screen, the news-risk strips on Home, and the
# news block on each setup.
#   true (default) -> TradingView's calendar service is tried first (it has
#                     numeric actual/forecast/previous plus years of release
#                     history, which is what the "what did this market do the
#                     last 10 times?" study measures against real candles).
#                     ForexFactory is the second line: schedule only, no
#                     actuals, this week only.
#   false          -> the whole news feature falls back to the seeded demo
#                     calendar, clearly badged as such.
ENABLE_NEWS=true

# Optional third source: investing.com's scraped calendar.
#
# Leave this OFF (the default) on Vercel. investing.com sits behind Cloudflare
# and rejects Node's TLS fingerprint — not the headers, the ClientHello itself.
# Verified: plain fetch -> 403, fetch with full browser headers -> 403, and
# node:https with Chrome's exact cipher list / curves / sigalgs -> 403 plus a
# Cloudflare challenge body. The same URL returns 200 to curl. This is not
# fixable from inside Node, so the provider stays opt-in for people running the
# app somewhere that can reach the site (a residential box, a proxy).
# Nothing is lost by leaving it off: TradingView is strictly richer.
ENABLE_INVESTING_CALENDAR=false

# How long a calendar response is cached, in seconds. Default 900 (15 min).
# The release-reaction study has its own, much longer cache, because past
# candles do not change.
NEWS_TTL_SECONDS=900


# === Database (Supabase) ===================================================
#
# All three are needed together. If the project URL and anon key are absent the
# app stores settings, journal entries, rules and positions in the browser's
# localStorage instead, and says so on the Settings screen.
#
# Schema lives in `supabase/migrations/0001_init.sql` — run it with
# `supabase db push`, or paste it into the SQL editor of a new project.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
# Public by design (hence NEXT_PUBLIC_): it is shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Also public by design. Row Level Security is what
# protects the data — every table in the migration has RLS enabled and
# per-user `auth.uid()` policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS completely. NEVER prefix this with
# NEXT_PUBLIC_ and never import it into a "use client" module. It exists so
# server-side jobs can write shared data (candles, assets, news) that users are
# only allowed to read.
SUPABASE_SERVICE_ROLE_KEY=
