# Regenerated by Next on every `dev` and `build`, and it rewrites itself
# depending on which features the app currently uses — committing it just
# produces spurious diffs.
next-env.d.ts

# Scratch probes used while measuring providers (TLS fingerprints, calendar
# payload shapes, candle slicing). Useful locally, not part of the app.
.tmp/

# Vercel's local link file. Contains the project/org id, not a secret, but it
# is machine-specific and should not be committed.
.vercel/
